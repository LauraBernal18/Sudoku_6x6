<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="center" prefHeight="700" prefWidth="600" spacing="15" style="-fx-background-color: #f9f9f9; -fx-padding: 15;" xmlns="http://javafx.com/javafx/17.0.16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sudoku.controllers.SudokuController">

    <!-- Título -->
    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Sudoku 6x6" />

    <!-- Cuadrícula principal: 2 filas × 3 columnas de bloques -->
    <GridPane fx:id="gridSudoku" alignment="center" style="-fx-padding: 10;">

        <!-- Bloques 2x3 -->
        <!-- Fila 0, Columna 0 -->
        <GridPane hgap="2" style="-fx-border-color: gray; -fx-border-width: 3; -fx-background-color: gray;" vgap="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <TextField fx:id="cell00" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="cell01" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="cell02" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="cell10" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="cell11" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="cell12" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Fila 0, Columna 1 -->
        <GridPane hgap="2" style="-fx-border-color: gray; -fx-border-width: 3; -fx-background-color: gray;" vgap="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <TextField fx:id="cell03" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="cell04" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="cell05" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="cell13" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="cell14" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="cell15" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Fila 1, Columna 0 -->
        <GridPane hgap="2" style="-fx-border-color: gray; -fx-border-width: 3; -fx-background-color: gray;" vgap="2" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <TextField fx:id="cell20" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="cell21" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="cell22" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="cell30" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="cell31" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="cell32" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Fila 1, Columna 1 -->
        <GridPane hgap="2" style="-fx-border-color: gray; -fx-border-width: 3; -fx-background-color: gray;" vgap="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <TextField fx:id="cell23" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="cell24" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="cell25" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="cell33" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="cell34" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="cell35" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Fila 2, Columna 0 -->
        <GridPane hgap="2" style="-fx-border-color: gray; -fx-border-width: 3; -fx-background-color: gray;" vgap="2" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <TextField fx:id="cell40" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="cell41" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="cell42" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="cell50" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="cell51" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="cell52" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Fila 2, Columna 1 -->
        <GridPane hgap="2" style="-fx-border-color: gray; -fx-border-width: 3; -fx-background-color: gray;" vgap="2" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <TextField fx:id="cell43" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="cell44" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="cell45" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="cell53" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="cell54" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="cell55" alignment="center" prefHeight="60" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
      <columnConstraints>
         <ColumnConstraints />
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <!-- Botones -->
    <HBox alignment="center" spacing="15">
        <Button fx:id="btnNuevoJuego" onAction="#nuevoJuego" text="Nuevo Juego" />
        <Button fx:id="btnVerificar" onAction="#verificarSudoku" text="Verificar" />
        <Button fx:id="btnAyuda" onAction="#mostrarAyuda" text="Ayuda" />
    </HBox>

    <!-- Mensajes -->
    <Label fx:id="lblMensaje" alignment="center" style="-fx-font-size: 16px; -fx-text-fill: #2E8B57;" text="Bienvenido al Sudoku 6x6" />

    <TextArea fx:id="txtInstrucciones" editable="false" prefHeight="131.0" prefWidth="570.0" style="-fx-font-size: 14px; -fx-control-inner-background: #f0f8ff;" text="Instrucciones del juego:&#10;1) Llena cada celda con un número del 1 al 6.&#10;2) No repitas números en filas, columnas ni en cada bloque 2x3.&#10;3) Usa el botón 'Nuevo Juego' para generar un tablero distinto.&#10;4) Usa 'Verificar' para revisar si el Sudoku está correcto.&#10;5) Usa 'Ayuda' si te quedas atascado (opción limitada)." wrapText="true" />
</VBox>
