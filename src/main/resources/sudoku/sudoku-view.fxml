<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sudoku.controllers.SudokuController">

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <!-- Título -->
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Sudoku 6x6" />

    <!-- Tablero (se llena desde el controlador después) -->
    <GridPane fx:id="boardGrid" hgap="2" style="-fx-background-color: lightgray;" vgap="2" />

    <!-- Botones -->
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="newGameButton" text="Nuevo Juego" />
        <Button fx:id="helpButton" text="Ayuda" />
    </HBox>

    <!-- Mensajes -->
    <Label fx:id="messageLabel" style="-fx-text-fill: red;" text="" />

</VBox>
